              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientFeatures"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters used"
          },
          "403": {
            "description": "Was not allowed to access features"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
