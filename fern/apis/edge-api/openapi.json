            "properties": {
              "appName": {
                "type": "string"
              },
              "bucket": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/MetricBucket"
                  }
                ]
              },
              "connectionId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "environment": {
                "type": [
                  "string",
