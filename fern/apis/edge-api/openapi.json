              },
              "connectionId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "environment": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "instanceId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interval": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "projects": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "started": {
                "type": "string",
                "format": "date-time"
              },
              "strategies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "ClientFeature": {
        "type": "object",
        "required": [
          "name",
          "enabled"
        ],
        "properties": {
          "createdAt": {
            "type": [
              "string",
