  "components": {
    "schemas": {
      "BTreeMap": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "propertyNames": {
          "type": "string"
        }
      },
      "BatchMetricsRequestBody": {
        "type": "object",
        "required": [
          "applications",
          "metrics"
        ],
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientApplication"
            }
          },
          "impactMetrics": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ImpactMetric"
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientMetricsEnv"
            }
          }
        }
      },
      "Bucket": {
        "type": "object",
        "required": [
          "le",
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "le": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "BucketMetricSample": {
        "type": "object",
        "required": [
