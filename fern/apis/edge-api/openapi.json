            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "stale": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "strategies": {
            "type": [
              "array",
              "null"
            ],
            "items": {
